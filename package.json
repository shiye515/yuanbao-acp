{
  "name": "yuanbao-acp",
  "version": "0.8.6",
  "description": "Bridge Tencent Yuanbao to any ACP-compatible AI agent",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "bin": {
    "yuanbao-acp": "./dist/bin/yuanbao-acp.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/bin/yuanbao-acp.js",
    "dev": "tsc --watch",
    "test": "node --import tsx/esm --test tests/**/*.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.16.1",
    "applicationinsights": "^2.9.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiye515/yuanbao-acp.git"
  },
  "homepage": "https://github.com/shiye515/yuanbao-acp#readme",
  "bugs": {
    "url": "https://github.com/shiye515/yuanbao-acp/issues"
  },
  "license": "MIT",
  "keywords": [
    "yuanbao",
    "tencent",
    "acp",
    "agent-client-protocol",
    "ai-agent",
    "bridge"
  ]
}
